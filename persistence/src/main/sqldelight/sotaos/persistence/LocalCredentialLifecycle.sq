CREATE TABLE local_credential_audit (
    audit_id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    unit_id TEXT NOT NULL,
    login_handle TEXT NOT NULL,
    revision INTEGER NOT NULL,
    operation TEXT NOT NULL,
    actor_person_id TEXT,
    occurred_at TEXT NOT NULL,
    FOREIGN KEY(unit_id, login_handle) REFERENCES local_credential(unit_id, login_handle)
);

CREATE TRIGGER credential_audit_no_update BEFORE UPDATE ON local_credential_audit
BEGIN SELECT RAISE(ABORT, 'credential audit is append-only'); END;
CREATE TRIGGER credential_audit_no_delete BEFORE DELETE ON local_credential_audit
BEGIN SELECT RAISE(ABORT, 'credential audit is append-only'); END;

insertCredentialAudit:
INSERT INTO local_credential_audit(unit_id, login_handle, revision, operation, actor_person_id, occurred_at)
VALUES (?, ?, ?, ?, ?, ?);

credentialHistory:
SELECT * FROM local_credential_audit WHERE unit_id = ? AND login_handle = ? ORDER BY audit_id;

rotateLocalCredential:
UPDATE local_credential SET salt_base64 = ?, hash_base64 = ?, iterations = ?, created_at = ?,
    revision = revision + 1, failed_attempts = 0, locked_until = NULL
WHERE unit_id = ? AND login_handle = ? AND revision = ? AND revoked_at IS NULL;

revokeLocalCredential:
UPDATE local_credential SET revoked_at = ?, revision = revision + 1
WHERE unit_id = ? AND login_handle = ? AND revision = ? AND revoked_at IS NULL;
